# Server Port
PORT=3000

# Authentication: firebase for the app, legacy only for the old demo endpoints.
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS points to a service account file OUTSIDE Git.
# It must belong to FIREBASE_PROJECT_ID; all Firebase and Google routes share it.
GOOGLE_APPLICATION_CREDENTIALS=
# Local tests only: FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 (never production).

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/lingoroad?schema=public"

# JWT Secret Keys & Expiration
JWT_SECRET="lingoroad-super-secret-jwt-key-for-development-change-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS="30"

# Redis Cache (Local Dev: 6380 via docker-compose, 6379 via local service)
REDIS_HOST="localhost"
REDIS_PORT=6380

# Environment
NODE_ENV="development"

# ML Microservice & AI
ML_SERVICE_URL="http://localhost:8001"
ML_INTERNAL_TOKEN=""
SPEAKING_ENABLED="false"
SPEAKING_SCORING_PROFILE="read-aloud-v2"
ML_SERVICE_TIMEOUT_MS=15000
GEMINI_API_KEY=""


# Enable each Speaking mode after its ML readiness is verified.
SPEAKING_READ_ALOUD_ENABLED=true
SPEAKING_TOPIC_ENABLED=false
SPEAKING_GAME_ENABLED=false

# Voice Live uses a separate Japan East resource. Local credentials are gitignored.
VOICE_LIVE_ENABLED=false
AZURE_VOICE_LIVE_ENV_FILE="../../config/local/azure/lingoroad-voice-live.env"
AZURE_VOICE_LIVE_MODEL=gpt-4o
AZURE_VOICE_LIVE_VOICE=en-US-AndrewMultilingualNeural
AZURE_VOICE_LIVE_API_VERSION=2026-07-15
