# Server Port
PORT=3000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/lingoroad?schema=public"

# JWT Secret Keys & Expiration
JWT_SECRET="lingoroad-super-secret-jwt-key-for-development-change-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS="30"

# Redis Cache (Local Dev: 6380 via docker-compose, 6379 via local service)
REDIS_HOST="localhost"
REDIS_PORT=6380

# Environment
NODE_ENV="development"

# ML Microservice & AI
ML_SERVICE_URL="http://localhost:8001"
ML_INTERNAL_TOKEN=""
ML_SERVICE_TIMEOUT_MS=15000
GEMINI_API_KEY=""

# Firebase Admin SDK (Google Authentication)
FIREBASE_PROJECT_ID="lingoroad-app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@lingoroad-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

