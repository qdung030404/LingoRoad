# ==============================================================================
# LingoRoad AI/ML Service Configuration
# ==============================================================================

# Internal Auth Token giữa Backend NestJS và ML Service (nếu có yêu cầu xác thực)
LINGOROAD_ML_INTERNAL_TOKEN="dev-internal-token"

# --- Option 1: Cấu hình OpenAI hoặc Third-Party Proxy (ví dụ: Motapis, OneAPI) ---
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="sk-..."
LINGOROAD_LLM_MODEL_VERSION="gpt-4o-mini"

# --- Option 2: Cấu hình Google Gemini trực tiếp ---
GEMINI_API_KEY="AIzaSy..."
# LINGOROAD_LLM_MODEL_VERSION="gemini-2.5-flash"

# --- Cấu hình Embedding / RAG (Tùy chọn) ---
