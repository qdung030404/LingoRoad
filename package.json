{
  "name": "lingoroad",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "devDependencies": {
    "cross-env": "^7.0.3"
  },
  "scripts": {
    "demo:setup": "pwsh -NoProfile -File scripts/setup-demo.ps1",
    "demo:start": "pwsh -NoProfile -File run_demo.ps1",
    "demo:test": "pwsh -NoProfile -File run_demo.ps1 -Test",
    "backend:dev": "npm run start:dev --workspace=apps/backend",
    "backend:build": "npm run build --workspace=apps/backend",
    "backend:start": "node apps/backend/dist/main",
    "ml:dev": "apps/ml/.venv/Scripts/uvicorn lingoroad_ml.serving.app:app --app-dir apps/ml --env-file apps/ml/.env --host 0.0.0.0 --port 8001 --reload",
    "frontend:dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 npm run dev --workspace=apps/frontend-web",
    "frontend:build": "npm run build --workspace=apps/frontend-web",
    "frontend:start": "npm run start --workspace=apps/frontend-web"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  }
}
