# Tự động chuẩn hóa mọi file văn bản về LF
* text=auto eol=lf

# Bắt buộc các script shell/bash luôn dùng LF (chống lỗi trên Linux/Docker)
*.sh text eol=lf

# File script dành riêng cho Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Giữ nguyên các định dạng nhị phân (Binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.ttf binary
*.otf binary
*.pdf binary
